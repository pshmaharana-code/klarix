test('Phase 6 candidate enforces qualified sample and evidence gates', () => {
  const insufficient = buildPatternCandidate(Array.from({ length: 9 }, (_, index) => ({
    contentId: `content-${index}`,
    interactionRate: 0.1
  })));
  assert.equal(insufficient.status, 'INSUFFICIENT_DATA');
  assert.equal(insufficient.patterns.length, 0);

  const qualified = [0.20, 0.18, 0.17, 0.16, 0.15, 0.10, 0.09, 0.08, 0.07, 0.06]
    .map((interactionRate, index) => ({ contentId: `content-${index}`, interactionRate }));
  const candidate = buildPatternCandidate(qualified);

  assert.equal(candidate.status, 'READY');
  assert.equal(candidate.sampleSize, 10);
  assert.ok(candidate.patterns[0].confidence > 0);
  assert.ok(candidate.patterns[0].evidence.length >= 2);
});


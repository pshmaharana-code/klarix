<file path="backend/test-throttle.js">
import Redis from 'ioredis';
const redis = new Redis('redis://localhost:6379');

const RATE_LIMIT_SCRIPT = `
  local last_request = tonumber(redis.call("GET", KEYS[1]))
  local now = tonumber(ARGV[1])
  local interval = tonumber(ARGV[2])

  if last_request == nil or now >= last_request + interval then
    redis.call("SET", KEYS[1], now, "PX", interval)
    return 0
  else
    local next_allowed = last_request + interval
    local ttl = (next_allowed - now) + interval
    redis.call("SET", KEYS[1], tostring(next_allowed), "PX", tostring(ttl))
    return next_allowed - now
  end
`;

redis.defineCommand('throttle', {
  numberOfKeys: 1,
  lua: RATE_LIMIT_SCRIPT
});

async function test() {
  const model = 'test-model';
  const key = `ratelimit:${model}`;
  await redis.del(key);
  
  const interval = 1000;
  
  for(let i=0; i<3; i++) {
    const wait = await redis.throttle(key, Date.now(), interval);
    console.log(`Req ${i}: wait ${wait}ms`);
  }
  
  redis.disconnect();
}

test();

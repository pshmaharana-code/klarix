import test from 'node:test';
import assert from 'node:assert/strict';
process.env.DATABASE_URL = 'postgresql://postgres:postgres@localhost:5432/klarix_test?schema=public';
process.env.NODE_ENV = 'test';

const {
  calculateBaselineComparison,
  calculateInteractionComparison,
  calculatePercentile
} = await import('../services/contentAnalyticsService.js');

test('Phase 5 comparison helpers classify positive, negative, and stable trends', () => {
  assert.deepEqual(
    calculateInteractionComparison([{ interactionRate: 0.1 }, { interactionRate: 0.2 }]),
    { interactionRateTrend: 1, growth: 'POSITIVE' }
  );

  assert.deepEqual(
    calculateInteractionComparison([{ interactionRate: 0.2 }, { interactionRate: 0.1 }]),
    { interactionRateTrend: -0.5, growth: 'NEGATIVE' }
  );

  assert.deepEqual(
    calculateInteractionComparison([{ interactionRate: 0.1 }, { interactionRate: 0.1 }]),
    { interactionRateTrend: 0, growth: 'STABLE' }
  );
});

test('Phase 5 comparison helpers handle missing, zero, and uneven data', () => {
  assert.deepEqual(
    calculateInteractionComparison([{ interactionRate: null }, { interactionRate: 0.1 }]),
    { interactionRateTrend: null, growth: null }
  );

  assert.deepEqual(
    calculateInteractionComparison([{ interactionRate: 0 }, { interactionRate: 0.1 }]),
    { interactionRateTrend: null, growth: 'INSUFFICIENT_DATA' }
  );

  const uneven = calculateInteractionComparison([
    { interactionRate: 0.1 },
    { interactionRate: 0.1 },
    { interactionRate: 0.2 }
  ]);
  assert.equal(uneven.growth, 'POSITIVE');
  assert.ok(Math.abs(uneven.interactionRateTrend - 0.5) < 1e-12);
});

test('Phase 5 percentile and baseline comparisons are directionally correct', () => {
  assert.equal(calculatePercentile(0.1, [0.1, 0.2, 0.3]), 33);
  assert.equal(calculatePercentile(0.3, [0.1, 0.2, 0.3]), 100);
  assert.equal(calculatePercentile(null, [0.1, 0.2, 0.3]), null);

  assert.equal(calculateBaselineComparison(0.3, 0.2).performance, 'ABOVE');
  assert.equal(calculateBaselineComparison(0.1, 0.2).performance, 'BELOW');
  assert.equal(calculateBaselineComparison(0.2, 0.2).performance, 'AT_BASELINE');
});

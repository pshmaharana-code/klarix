import test from 'node:test';
import assert from 'node:assert';
import { callAgent } from '../services/openRouterClient.js';
import * as configLib from '../lib/config.js';

// Setup env variables for testing
process.env.GEMINI_API_KEY = 'test-key';
process.env.NODE_ENV = 'production'; // to bypass mocked response in openRouterClient

test('Phase 4 — Gemini Rate Limiting and Fallback', async (t) => {

  await t.test('throttleRequest queues concurrent requests', async () => {
    // We will mock the global fetch
    let fetchCount = 0;
    const fetchTimestamps = [];
    
    const originalFetch = global.fetch;
    global.fetch = async (url, options) => {
      fetchCount++;
      fetchTimestamps.push(Date.now());
      return {
        ok: true,
        json: async () => ({ candidates: [{ content: { parts: [{ text: '{}' }] } }] })
      };
    };

    try {
      // Fire 3 concurrent requests
      const promises = [
        callAgent('sys', 'user', false, false),
        callAgent('sys', 'user', false, false),
        callAgent('sys', 'user', false, false)
      ];
      
      await Promise.all(promises);
      
      assert.strictEqual(fetchCount, 3);
      
      // Calculate elapsed time between first and last request
      const elapsed = fetchTimestamps[2] - fetchTimestamps[0];
      const rpm = parseInt(process.env.GEMINI_RPM_LIMIT || '4', 10);
      const interval = Math.ceil(60000 / rpm);
      const expectedElapsed = interval * 2 - 50; // allow 50ms tolerance
      assert.ok(elapsed >= expectedElapsed, `Requests were not spaced out enough! Elapsed: ${elapsed}ms, Expected at least: ${expectedElapsed}ms`);
      
    } finally {
      global.fetch = originalFetch;
    }
  });

  await t.test('HTTP 429 throws retryable error and does not fallback instantly', async () => {
    const originalFetch = global.fetch;
    let fetchCount = 0;
    
    global.fetch = async (url, options) => {
      fetchCount++;
      return {
        ok: false,
        status: 429,
        headers: new Map([['Retry-After', '60']]),
        json: async () => ({ error: { message: 'Quota exceeded' } })
      };
    };

    try {
      await callAgent('sys', 'user', false, false);
      assert.fail('Should have thrown an error');
    } catch (e) {
      assert.strictEqual(fetchCount, 1, 'Should NOT have called fallback (fetchCount should be 1)');
      assert.strictEqual(e.retryable, true);
      assert.strictEqual(e.retryAfter, 60);
      assert.ok(e.message.includes('Quota limit reached'));
    } finally {
      global.fetch = originalFetch;
    }
  });

  await t.test('HTTP 503 falls back to secondary model', async () => {
    const originalFetch = global.fetch;
    let fetchCount = 0;
    const requestedModels = [];
    
    global.fetch = async (url, options) => {
      fetchCount++;
      if (url.includes('gemini-3.8-flash')) {
        requestedModels.push('3.8');
        return {
          ok: false,
          status: 503,
          headers: new Map(),
          json: async () => ({ error: { message: 'Overloaded' } })
        };
      } else {
        requestedModels.push('3.6');
        return {
          ok: true,
          json: async () => ({ candidates: [{ content: { parts: [{ text: '{}' }] } }] })
        };
      }
    };

    try {
      await callAgent('sys', 'user', false, false);
      assert.strictEqual(fetchCount, 2, 'Should have called primary then fallback');
      assert.deepStrictEqual(requestedModels, ['3.8', '3.6']);
    } finally {
      global.fetch = originalFetch;
    }
  });

});
</file>

<file path="backend/test/v2-phase4-shared-ratelimit.test.js">
import test from 'node:test';
import assert from 'node:assert';
import { fork } from 'node:child_process';
import { fileURLToPath } from 'node:url';
import { dirname, join } from 'node:path';
import Redis from 'ioredis';
import { loadConfig } from '../lib/config.js';

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);

// Ensure we use real Redis for integration testing
const redisConfig = loadConfig();
const redis = new Redis(redisConfig.redisUrl);

test('Phase 4 — Shared Redis Rate Limiting across processes', async (t) => {
  const GEMINI_RPM_LIMIT = parseInt(process.env.GEMINI_RPM_LIMIT || '4', 10);
  const GEMINI_INTERVAL_MS = Math.ceil(60000 / GEMINI_RPM_LIMIT);
  const MODEL = 'gemini-3.8-flash';
  const REDIS_KEY = `ratelimit:gemini:${MODEL}`;

  await t.test('Concurrent cross-process requests are strictly spaced by Redis', async () => {
    // Clear Redis key first
    await redis.del(REDIS_KEY);

    // We will spawn 2 child processes that both try to call callAgent concurrently
    // To isolate just the rate limiter, we can have the child processes directly hit throttleReq
    // or call callAgent with mocked fetch.
    // Instead of full processes calling callAgent, we will fork a small script that 
    // imports openRouterClient and calls callAgent.
    
    // Create a temporary script for the child process
    const childScript = join(__dirname, '..', 'scratch-child-limiter.mjs');
    
    const fs = await import('node:fs/promises');
    await fs.writeFile(childScript, `
      import { callAgent } from './services/openRouterClient.js';
      
      process.env.NODE_ENV = 'production';
      process.env.GEMINI_API_KEY = 'test-key';
      
      // Mock fetch
      global.fetch = async () => {
        return {
          ok: true,
          json: async () => ({ candidates: [{ content: { parts: [{ text: '{}' }] } }] })
        };
      };
      
      async function run() {
        const start = Date.now();
        await callAgent('sys', 'user', false, false);
        const end = Date.now();
        process.send({ start, end });
        process.exit(0);
      }
      run();
    `);

    try {
      const runChild = () => new Promise((resolve, reject) => {
        const child = fork(childScript);
        let result = null;
        child.on('message', msg => { result = msg; });
        child.on('exit', code => {
          if (code !== 0) reject(new Error('Child failed'));
          else resolve(result);
        });
      });

      // Spawn 3 processes simultaneously
      const [res1, res2, res3] = await Promise.all([
        runChild(),
        runChild(),
        runChild()
      ]);

      const startTimes = [res1.start, res2.start, res3.start];
      const endTimes = [res1.end, res2.end, res3.end];
      
      const minStart = Math.min(...startTimes);
      const maxEnd = Math.max(...endTimes);
      const elapsed = maxEnd - minStart;
      
      // 3 requests should take at least 2 intervals
      const expectedElapsed = GEMINI_INTERVAL_MS * 2 - 200; // allow generous 200ms tolerance for IPC/fork overhead
      assert.ok(elapsed >= expectedElapsed, `Requests across processes were not spaced! Elapsed: ${elapsed}ms, Expected at least: ${expectedElapsed}ms`);
      
    } finally {
      await fs.unlink(childScript).catch(() => {});
    }
  });

  await t.test('Different models have independent limits', async () => {
    // Clear both keys
    await redis.del('ratelimit:gemini:gemini-3.8-flash');
    await redis.del('ratelimit:gemini:gemini-3.6-flash');
    
    // We can test this in the main process
    const { callAgent } = await import('../services/openRouterClient.js');
    
    // Mock fetch in main process
    const originalFetch = global.fetch;
    global.fetch = async () => ({
      ok: true,
      json: async () => ({ candidates: [{ content: { parts: [{ text: '{}' }] } }] })
    });
    
    try {
      const start = Date.now();
      // Call primary and fallback concurrently
      await Promise.all([
        callAgent('sys', 'user', false, false), // uses 3.8
        callAgent('sys', 'user', false, true)   // uses 3.6 (fallback)
      ]);
      const elapsed = Date.now() - start;
      
      // If they shared the limit, elapsed would be >= GEMINI_INTERVAL_MS
      assert.ok(elapsed < GEMINI_INTERVAL_MS, 'Models did not have independent limits');
    } finally {
      global.fetch = originalFetch;
    }
  });
  
  await t.test('Redis unavailability fails safely and cleanly', async () => {
    // To simulate Redis unavailability, we will configure a dummy Redis client
    // that connects to a dead port. We can inject this by altering env momentarily.
    
    const childScript = join(__dirname, '..', 'scratch-child-dead-redis.mjs');
    const fs = await import('node:fs/promises');
    await fs.writeFile(childScript, `
      process.env.REDIS_URL = 'redis://localhost:9999'; // Dead port
      process.env.NODE_ENV = 'production';
      process.env.GEMINI_API_KEY = 'test-key';
      
      const { callAgent } = await import('./services/openRouterClient.js');
      
      async function run() {
        try {
          await callAgent('sys', 'user', false, false);
          process.send({ success: true });
        } catch (err) {
          process.send({ success: false, retryable: err.retryable, message: err.message });
        }
        process.exit(0);
      }
      run();
    `);

    try {
      const runChild = () => new Promise((resolve) => {
        const child = fork(childScript);
        let result = null;
        child.on('message', msg => { result = msg; });
        child.on('exit', () => resolve(result));
      });

      const res = await runChild();
      assert.strictEqual(res.success, false);
      assert.strictEqual(res.retryable, true);
      assert.ok(res.message.includes('Redis rate limiter unavailable'));
      
    } finally {
      await fs.unlink(childScript).catch(() => {});
    }
  });

});
</file>


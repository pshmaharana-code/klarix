test('Worker FETCH_METRICS populates ContentMetricSnapshot and ContentDerivedMetric idempotently', async (t) => {
  t.after(async () => {
    await cleanDb();
    await prisma.$disconnect();
  });

  await cleanDb();

  await prisma.user.create({
    data: {
      id: 'user-worker-1',
      email: 'worker-phase5@example.com',
      password: 'test-password'
    }
  });

  const brand = await prisma.brand.create({
    data: { id: 'brand-worker-1', ownerUserId: 'user-worker-1', name: 'Test Brand' }
  });

  const account = await prisma.socialAccount.create({
    data: {
      id: 'acc-worker-1',
      brandId: brand.id,
      platform: 'INSTAGRAM',
      externalAccountId: 'ext-1',
      username: 'user1',
      connectionStatus: 'CONNECTED',
      encryptedToken: cryptoLib.encrypt('mock-token')
    }
  });

  const content = await prisma.content.create({
    data: {
      id: 'content-worker-1',
      brandId: brand.id,
      socialAccountId: account.id,
      externalContentId: 'c1',
      type: 'IMAGE',
      publishedAt: new Date('2026-09-01T12:00:00Z')
    }
  });

  const job = await prisma.job.create({
    data: {
      brandId: brand.id,
      type: 'FETCH_METRICS',
      state: 'QUEUED',
      idempotencyKey: 'metrics-job-1',
      input: {
        contentId: content.id,
        socialAccountId: account.id,
        externalContentId: 'c1',
        item: { type: 'IMAGE' },
        observationDate: '2026-09-24T00:00:00.000Z'
      }
    }
  });

  const mockJob = {
    id: job.id,
    name: 'sync',
    data: { 
      jobId: job.id,
      brandId: brand.id,
      input: {
        contentId: content.id,
        socialAccountId: account.id,
        externalContentId: 'c1',
        item: { type: 'IMAGE' },
        observationDate: '2026-09-24T00:00:00.000Z'
      }
    },
    updateProgress: () => {}
  };

  // Run the worker
  let result;
  if (workerCallback) {
    result = await workerCallback(mockJob);
  } else {
    result = await processJob(mockJob, 'mock-token');
  }
  assert.equal(result.success, true);
  
  // Verify snapshot
  const snapshots = await prisma.contentMetricSnapshot.findMany({
    where: { contentId: content.id }
  });
  
  assert.equal(snapshots.length, 1);
  assert.equal(snapshots[0].reach, 1000);
  assert.equal(snapshots[0].likes, 100);
  assert.equal(snapshots[0].rawPayload.mocked, true);

  // Verify derived metric
  const derived = await prisma.contentDerivedMetric.findMany({
    where: { contentId: content.id }
  });
  
  assert.equal(derived.length, 1);
  assert.equal(derived[0].likeRate, 100 / 1000);
  assert.equal(derived[0].commentRate, 20 / 1000);
  assert.equal(derived[0].sourceSnapshotId, snapshots[0].id);

  // Re-run the worker to verify idempotency (it shouldn't crash and should still leave 1 snapshot due to the unique constraint on contentId_observedAt, but actually createMetricSnapshot throws on duplicate. Wait, if it throws, the job will fail. Let's see what the job does.)
  // Actually, worker uses createMetricSnapshot which throws P2002 on duplicate, causing job to fail if we rerun exactly. But worker has `idempotencyKey` guard at the start.
  
  // To test the retry conflict we simulate a QUEUED job with the same parameters
  await prisma.job.update({
    where: { id: job.id },
    data: { state: 'QUEUED' }
  });

  if (workerCallback) {
    result = await workerCallback(mockJob);
  } else {
    result = await processJob(mockJob, 'mock-token');
  }
  
  const rerunSnapshots = await prisma.contentMetricSnapshot.findMany({
    where: { contentId: content.id }
  });
  
  assert.equal(rerunSnapshots.length, 1);
  assert.equal(result.success, true);

  const rerunDerived = await prisma.contentDerivedMetric.findFirst({
    where: { contentId: content.id }
  });
  assert.equal(rerunDerived.likeRate, 100 / 1000);
});

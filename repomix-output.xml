await mock.module('../services/postAnalysisOrchestrator.js', {
  exports: {
    analyzePost: async (...args) => {
      if (analyzePostMock) {
        return analyzePostMock(...args);
      }
      return { status: 'COMPLETED', confidence: 1.0 };
    }
  }
});

// Import processJob directly from worker.js
const { processJob } = await import('../worker.js');

describe('Phase 4 — Worker Retry-After and moveToDelayed Handling', () => {
  let testBrand;
  let testContent;
  let testUser;

  before(async () => {
    try {
      // Clean database before test suite
    await prisma.jobLog.deleteMany();
    await prisma.jobOutbox.deleteMany();
    await prisma.contentAnalysis.deleteMany();
    await prisma.job.deleteMany();
    await prisma.socialAccountMetricSnapshot.deleteMany();
    await prisma.contentMetricSnapshot.deleteMany();
    await prisma.contentMedia.deleteMany();
    await prisma.content.deleteMany();
    await prisma.socialAccount.deleteMany();
    await prisma.oAuthCredential.deleteMany();
    await prisma.brandMember.deleteMany();
    await prisma.brand.deleteMany();
    await prisma.user.deleteMany();

    testUser = await prisma.user.create({
      data: {
        id: 'user-retry-test',
        email: 'retry-test@example.com',
        password: 'hash'
      }
    });

    testBrand = await prisma.brand.create({
      data: {
        id: 'brand-retry-test',
        ownerUserId: testUser.id,
        name: 'Retry Test Brand'
      }
    });

    const socialAccount = await prisma.socialAccount.create({
      data: {
        id: 'social-retry-test',
        brandId: testBrand.id,
        platform: 'INSTAGRAM',
        externalAccountId: 'ig-retry-test',
        username: 'retryuser',
        accountType: 'BUSINESS',
        connectionStatus: 'CONNECTED'
      }
    });

    testContent = await prisma.content.create({
      data: {
        id: 'content-retry-test',
        brandId: testBrand.id,
        socialAccountId: socialAccount.id,
        externalContentId: 'media-retry-1',
        type: 'REEL',
        caption: 'Test caption',
        permalink: 'https://instagram.com/p/test',
        analysisStatus: 'NOT_STARTED'
      }
    });
    } catch (err) {
      console.error('BEFORE HOOK ERROR:', err);
      throw err;
    }
  });

  after(async () => {
    await prisma.$disconnect();
  });

  it('moves job to delayed with absolute timestamp and worker token when Retry-After is present', async () => {
    const dbJob = await prisma.job.create({
      data: {
        brandId: testBrand.id,
        type: 'ANALYZE_CONTENT',
        state: 'QUEUED',
        idempotencyKey: `test-job-${Date.now()}-${Math.random()}`,
        input: { contentId: testContent.id }
      }
    });

    // Mock analyzePost to fail with 503 and Retry-After: 20
    const providerError = new Error('503 Service Unavailable: High Demand');
    providerError.code = 'PROVIDER_UNAVAILABLE';
    providerError.retryAfter = 20;
    analyzePostMock = mock.fn(async () => {
      throw providerError;
    });

    const moveToDelayedCalls = [];
    const mockBullJob = {
      id: 'bull-job-retry-1',
      token: 'test-worker-token-xyz',
      data: {
        jobId: dbJob.id,
        brandId: testBrand.id,
        input: { contentId: testContent.id }
      },
      attemptsMade: 0,
      opts: { attempts: 3 },
      moveToDelayed: mock.fn(async (timestamp, token) => {
        moveToDelayedCalls.push({ timestamp, token });
      })
    };

    const startTime = Date.now();
    let caughtError = null;

    try {
      await processJob(mockBullJob, 'test-worker-token-xyz');
    } catch (err) {
      caughtError = err;
      console.error('CAUGHT ERROR IN TEST:', err);
    }

    try {
      // 1. Must throw DelayedError
      assert.ok(caughtError, 'Expected processJob to throw an error');
      assert.equal(caughtError.name, 'DelayedError');

      // 2. Must call job.moveToDelayed once
      assert.equal(mockBullJob.moveToDelayed.mock.callCount(), 1);
      const { timestamp, token } = moveToDelayedCalls[0];

      // 3. Delay must be calculated from current time (absolute timestamp >= startTime + 20000)
      assert.ok(timestamp >= startTime + 20000, `Timestamp ${timestamp} should be >= ${startTime + 20000}`);
      assert.ok(timestamp <= startTime + 25000, `Timestamp ${timestamp} should not be excessively delayed`);
      assert.equal(token, 'test-worker-token-xyz');

      // 4. Job state in database must be RETRY_PENDING, not FAILED
      const updatedJob = await prisma.job.findUnique({ where: { id: dbJob.id } });
      assert.equal(updatedJob.state, 'RETRY_PENDING');
      assert.equal(updatedJob.completedAt, null);
      assert.equal(updatedJob.progressStep, 'Retry pending');

      // 5. Content analysisStatus must NOT be FAILED
      const updatedContent = await prisma.content.findUnique({ where: { id: testContent.id } });
      assert.notEqual(updatedContent.analysisStatus, 'FAILED');

      // 6. No FAILED analysis row created
      const analyses = await prisma.contentAnalysis.findMany({ where: { contentId: testContent.id } });
      assert.equal(analyses.length, 0);
    } catch (assertionErr) {
      console.error('TEST 1 ASSERTION ERROR:', assertionErr.message, assertionErr.stack);
      throw assertionErr;
    }
  });

  it('marks job FAILED and throws UnrecoverableError without moveToDelayed when max attempts are reached', async () => {
    // Reset content analysisStatus
    await prisma.content.update({
      where: { id: testContent.id },
      data: { analysisStatus: 'NOT_STARTED' }
    });

    const dbJob = await prisma.job.create({
      data: {
        brandId: testBrand.id,
        type: 'ANALYZE_CONTENT',
        state: 'QUEUED',
        idempotencyKey: `test-job-${Date.now()}-${Math.random()}`,
        input: { contentId: testContent.id }
      }
    });

    // Mock analyzePost to fail with Retry-After: 30
    const providerError = new Error('429 Resource has been exhausted');
    providerError.code = 'QUOTA_EXCEEDED';
    providerError.retryAfter = 30;
    analyzePostMock = mock.fn(async () => {
      throw providerError;
    });

    const mockBullJob = {
      id: 'bull-job-retry-terminal',
      token: 'test-worker-token-term',
      data: {
        jobId: dbJob.id,
        brandId: testBrand.id,
        input: { contentId: testContent.id }
      },
      // Job opts allows only 1 attempt, so attempt 1 is terminal
      attemptsMade: 0,
      opts: { attempts: 1 },
      moveToDelayed: mock.fn(async () => {})
    };

    let caughtError = null;
    try {
      await processJob(mockBullJob, 'test-worker-token-term');
    } catch (err) {
      caughtError = err;
    }

    // 1. Must throw UnrecoverableError so BullMQ does not retry
    assert.ok(caughtError, 'Expected processJob to throw');
    assert.equal(caughtError.name, 'UnrecoverableError');

    // 2. moveToDelayed must NOT have been called
    assert.equal(mockBullJob.moveToDelayed.mock.callCount(), 0);

    // 3. Database job state must be FAILED
    const updatedJob = await prisma.job.findUnique({ where: { id: dbJob.id } });
    assert.equal(updatedJob.state, 'FAILED');
    assert.notEqual(updatedJob.completedAt, null);

    // 4. Content analysisStatus must be FAILED
    const updatedContent = await prisma.content.findUnique({ where: { id: testContent.id } });
    assert.equal(updatedContent.analysisStatus, 'FAILED');

    // 5. ContentAnalysis record with FAILED persisted
    const analyses = await prisma.contentAnalysis.findMany({ where: { contentId: testContent.id } });
    assert.equal(analyses.length, 1);
    assert.equal(analyses[0].status, 'FAILED');
  });

  it('normal retryable error without Retry-After re-throws without moveToDelayed', async () => {
    const dbJob = await prisma.job.create({
      data: {
        brandId: testBrand.id,
        type: 'ANALYZE_CONTENT',
        state: 'QUEUED',
        idempotencyKey: `test-job-${Date.now()}-${Math.random()}`,
        input: { contentId: testContent.id }
      }
    });

    // 503 without Retry-After
    const providerError = new Error('503 Transient network glitch');
    providerError.code = 'PROVIDER_UNAVAILABLE';
    analyzePostMock = mock.fn(async () => {
      throw providerError;
    });

    const mockBullJob = {
      id: 'bull-job-normal-retry',
      token: 'test-worker-token-normal',
      data: {
        jobId: dbJob.id,
        brandId: testBrand.id,
        input: { contentId: testContent.id }
      },
      attemptsMade: 0,
      opts: { attempts: 3 },
      moveToDelayed: mock.fn(async () => {})
    };

    let caughtError = null;
    try {
      await processJob(mockBullJob, 'test-worker-token-normal');
    } catch (err) {
      caughtError = err;
    }

    // 1. Throws the original error so BullMQ can perform standard backoff
    assert.equal(caughtError, providerError);

    // 2. moveToDelayed is NOT called (BullMQ's moveToFailed manages delay)
    assert.equal(mockBullJob.moveToDelayed.mock.callCount(), 0);

    // 3. Job is RETRY_PENDING in database
    const updatedJob = await prisma.job.findUnique({ where: { id: dbJob.id } });
    assert.equal(updatedJob.state, 'RETRY_PENDING');
  });

  it('BullMQ real queue integration: moveToDelayed + DelayedError places job into delayed state', async () => {
    const queueName = `test-delayed-q-${Date.now()}`;
    const testQueue = new Queue(queueName, { connection: { host: 'localhost', port: 6379 } });
    
    let workerExecutionCount = 0;
    const testWorker = new Worker(queueName, async (job, token) => {
      workerExecutionCount++;
      if (workerExecutionCount === 1) {
        // First execution: delay by 1500ms
        const delayUntil = Date.now() + 1500;
        await job.moveToDelayed(delayUntil, token);
        throw new DelayedError();
      }
      return { success: true };
    }, { connection: { host: 'localhost', port: 6379 } });

    const bullJob = await testQueue.add('test-delay-item', { foo: 'bar' }, { attempts: 3 });

    // Wait 200ms for worker to execute run 1
    await new Promise(r => setTimeout(r, 200));

    // Confirm job state is 'delayed' in Redis
    const stateDuringDelay = await bullJob.getState();
    assert.equal(stateDuringDelay, 'delayed', 'BullMQ job state should be delayed after moveToDelayed');

    // Wait for the delay (1500ms) to elapse and job to be processed second time
    await new Promise(r => setTimeout(r, 2000));

    const finalState = await bullJob.getState();
    assert.equal(finalState, 'completed', 'Job should complete on retry run');
    assert.equal(workerExecutionCount, 2, 'Worker should have executed twice');

    await testWorker.close();
    await testQueue.close();
  });
});
</file>


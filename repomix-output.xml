test('Phase 5: Content Derived Metrics Repository', async (t) => {
  t.after(async () => {
    await cleanDb();
    await prisma.$disconnect();
  });
  
  await cleanDb();
  
  const user = await prisma.user.create({
    data: {
      email: `test_p5_${Date.now()}@example.com`,
      password: 'dummy'
    }
  });

  // Create a brand and content for testing
  const brand = await prisma.brand.create({
    data: { name: 'Phase 5 Test Brand', ownerUserId: user.id }
  });
  
  const account = await prisma.socialAccount.create({
    data: { brandId: brand.id, platform: 'INSTAGRAM', username: 'test_acc', connectionStatus: 'CONNECTED', externalAccountId: `ext_acc_${Date.now()}` }
  });

  const content = await prisma.content.create({
    data: {
      brandId: brand.id,
      socialAccountId: account.id,
      externalContentId: `test_ext_${Date.now()}`,
      type: 'IMAGE',
      publishedAt: new Date('2026-09-01T12:00:00Z')
    }
  });

  await t.test('upsertContentDerivedMetric stores calculated metrics', async () => {
    const metric = await contentRepository.upsertContentDerivedMetric({
      contentId: content.id,
      calculationVersion: '1.0',
      likeRate: 0.05,
      commentRate: 0.01,
      saveRate: 0.02,

    });

    assert.strictEqual(metric.contentId, content.id);
    assert.strictEqual(metric.likeRate, 0.05);
    assert.strictEqual(metric.interactionRate, 0.09);
    assert.strictEqual(metric.calculationVersion, '1.0');

    // Update with same keys should upsert correctly
    const updated = await contentRepository.upsertContentDerivedMetric({
      contentId: content.id,
      calculationVersion: '1.0',
      likeRate: 0.06
    });

    assert.strictEqual(updated.likeRate, 0.06);
    assert.strictEqual(updated.interactionRate, 0.09); // Preserved since omitted in update
  });

  await t.test('getAnalyticsOverview returns aggregated metrics for brand', async () => {
    // Restore interaction rate for the overview calculation
    await contentRepository.upsertContentDerivedMetric({
      contentId: content.id,
      calculationVersion: '1.0',
      likeRate: 0.06,
      interactionRate: 0.10
    });

    // Create another content for the same brand to test aggregation
    const content2 = await prisma.content.create({
      data: {
        brandId: brand.id,
        socialAccountId: account.id,
        externalContentId: `test_ext_2_${Date.now()}`,
        type: 'VIDEO',
        publishedAt: new Date('2026-09-02T12:00:00Z')
      }
    });

    await contentRepository.upsertContentDerivedMetric({
      contentId: content2.id,
      calculationVersion: '1.0',
      likeRate: 0.04,
      interactionRate: 0.20
    });

    const result = await getAnalyticsOverview(brand.id);
    
    assert.strictEqual(result.overview.totalContent, 2);
    assert.strictEqual(result.overview.calculationVersion, '1.0');
    // Averages: (0.10 + 0.20)/2 = 0.15
    assert.ok(Math.abs(result.overview.avgInteractionRate - 0.15) < 0.0001);
    // (0.06 + 0.04)/2 = 0.05
    assert.ok(Math.abs(result.overview.avgLikeRate - 0.05) < 0.0001);

    assert.strictEqual(result.series.length, 2);
    assert.strictEqual(result.series[0].contentId, content.id);
    assert.strictEqual(result.series[1].contentId, content2.id);
  });

  await t.test('getAnalyticsOverview handles date filters', async () => {
    const result = await getAnalyticsOverview(brand.id, {
      from: '2026-09-02T00:00:00Z',
      to: '2026-09-03T00:00:00Z'
    });

    assert.strictEqual(result.overview.totalContent, 1);
    assert.strictEqual(result.overview.avgInteractionRate, 0.20);
    assert.strictEqual(result.series.length, 1);
    assert.strictEqual(result.series[0].type, 'VIDEO');
  });

  await t.test('getAnalyticsOverview handles content type filters', async () => {
    const result = await getAnalyticsOverview(brand.id, {
      contentType: 'IMAGE'
    });

    assert.strictEqual(result.overview.totalContent, 1);
    assert.strictEqual(result.series[0].type, 'IMAGE');
  });

  await t.test('getAnalyticsOverview calculates trends correctly (positive, negative)', async () => {
    const content3 = await prisma.content.create({
      data: { brandId: brand.id, socialAccountId: account.id, externalContentId: `ext_3_${Date.now()}`, type: 'IMAGE', publishedAt: new Date('2026-09-03T12:00:00Z') }
    });
    const content4 = await prisma.content.create({
      data: { brandId: brand.id, socialAccountId: account.id, externalContentId: `ext_4_${Date.now()}`, type: 'VIDEO', publishedAt: new Date('2026-09-04T12:00:00Z') }
    });
    
    await contentRepository.upsertContentDerivedMetric({ contentId: content3.id, calculationVersion: '1.0', interactionRate: 0.05 });
    await contentRepository.upsertContentDerivedMetric({ contentId: content4.id, calculationVersion: '1.0', interactionRate: 0.07 });

    const result = await getAnalyticsOverview(brand.id);
    assert.strictEqual(result.comparisons.growth, 'NEGATIVE');
    assert.ok(result.comparisons.interactionRateTrend < -0.5);
  });

  await t.test('getAnalyticsOverview handles zero baseline and uneven series gracefully', async () => {
    // Need a brand with missing/zero data
    const newBrand = await prisma.brand.create({ data: { name: 'Empty Brand', ownerUserId: user.id } });
    let res = await getAnalyticsOverview(newBrand.id);
    assert.strictEqual(res.comparisons.interactionRateTrend, null);
    assert.strictEqual(res.comparisons.growth, null);

    // Uneven series (3 items)
    const acc = await prisma.socialAccount.create({ data: { brandId: newBrand.id, platform: 'INSTAGRAM', username: 'u2', connectionStatus: 'CONNECTED', externalAccountId: `ext_${Date.now()}` } });
    const c1 = await prisma.content.create({ data: { brandId: newBrand.id, socialAccountId: acc.id, externalContentId: `c1_${Date.now()}`, type: 'IMAGE', publishedAt: new Date('2026-09-01T12:00:00Z') } });
    const c2 = await prisma.content.create({ data: { brandId: newBrand.id, socialAccountId: acc.id, externalContentId: `c2_${Date.now()}`, type: 'IMAGE', publishedAt: new Date('2026-09-02T12:00:00Z') } });
    const c3 = await prisma.content.create({ data: { brandId: newBrand.id, socialAccountId: acc.id, externalContentId: `c3_${Date.now()}`, type: 'IMAGE', publishedAt: new Date('2026-09-03T12:00:00Z') } });
    
    // First half has 1 item, second half has 1 item (Wait, length 3 -> slice(0,1), slice(1)).
    // Actually slice(0, Math.floor(3/2)) = slice(0,1). slice(Math.floor(3/2)) = slice(1) which has 2 items.
    await contentRepository.upsertContentDerivedMetric({ contentId: c1.id, calculationVersion: '1.0', interactionRate: 0.0 });
    await contentRepository.upsertContentDerivedMetric({ contentId: c2.id, calculationVersion: '1.0', interactionRate: 0.1 });
    await contentRepository.upsertContentDerivedMetric({ contentId: c3.id, calculationVersion: '1.0', interactionRate: 0.1 });
    
    res = await getAnalyticsOverview(newBrand.id);
    // firstHalf: avg=0. secondHalf: avg=0.1
    // A relative trend is undefined when the first half has a zero baseline.
    assert.strictEqual(res.comparisons.interactionRateTrend, null);
    assert.strictEqual(res.comparisons.growth, 'INSUFFICIENT_DATA');
  });
});

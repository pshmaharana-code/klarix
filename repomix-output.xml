import test from 'node:test';
import assert from 'node:assert';
process.env.DATABASE_URL = 'postgresql://postgres:postgres@localhost:5432/klarix_test?schema=public';
process.env.NODE_ENV = 'test';

const { getAnalyticsOverview } = await import('../services/contentAnalyticsService.js');
const contentRepository = await import('../repositories/contentRepository.js');
const { PrismaClient } = await import('@prisma/client');

const prisma = new PrismaClient();

async function cleanDb() {

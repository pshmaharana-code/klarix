suite('Phase 6: Patterns API', () => {
  let ownerId;
  let otherUserId;
  let ownerToken;
  let brandId;
  let otherBrandId;
  let patternId;

  before(async () => {
    await cleanDb();
    server = app.listen(0);
    baseUrl = `http://localhost:${server.address().port}`;

    ownerId = 'phase6-api-owner';
    otherUserId = 'phase6-api-other';
    ownerToken = jwt.sign({ userId: ownerId }, loadConfig().jwtSecret, { expiresIn: '1h' });

    await prisma.user.createMany({
      data: [
        { id: ownerId, email: 'phase6-owner@example.com', password: 'hash' },
        { id: otherUserId, email: 'phase6-other@example.com', password: 'hash' }
      ]
    });
    brandId = 'phase6-api-brand';
    otherBrandId = 'phase6-api-other-brand';
    await prisma.brand.createMany({
      data: [
        { id: brandId, ownerUserId: ownerId, name: 'Phase 6 API Brand' },
        { id: otherBrandId, ownerUserId: otherUserId, name: 'Other Phase 6 Brand' }
      ]
    });
    const account = await prisma.socialAccount.create({
      data: {
        brandId,
        platform: 'INSTAGRAM',
        externalAccountId: 'phase6-api-account',
        username: 'phase6_api_fixture',
        connectionStatus: 'CONNECTED'
      }
    });

    const rates = [0.20, 0.18, 0.17, 0.16, 0.15, 0.10, 0.09, 0.08, 0.07, 0.06];
    for (const [index, interactionRate] of rates.entries()) {
      const content = await prisma.content.create({
        data: {
          brandId,
          socialAccountId: account.id,
          externalContentId: `phase6-api-content-${index}`,
          type: 'IMAGE',
          analysisStatus: 'COMPLETED',
          publishedAt: new Date(Date.UTC(2026, 8, index + 1, 12))
        }
      });
      const snapshot = await prisma.contentMetricSnapshot.create({
        data: { contentId: content.id, observedAt: new Date(Date.UTC(2026, 8, index + 1, 12)), reach: 1000 }
      });
      await prisma.contentDerivedMetric.create({
        data: { contentId: content.id, sourceSnapshotId: snapshot.id, calculationVersion: '1.0', interactionRate }
      });
    }

    const discovery = await discoverPatterns(brandId, { force: true });
    patternId = discovery.patternId;
  });

  after(async () => {
    server.close();
    await cleanDb();
    await prisma.$disconnect();
  });

  test('lists only active patterns with evidence counts', async () => {
    const response = await fetch(`${baseUrl}/api/v2/brands/${brandId}/patterns`, {
      headers: { Cookie: `token=${ownerToken}` }
    });
    const payload = await response.json();
    assert.equal(response.status, 200);
    assert.equal(payload.data.items.length, 1);
    assert.ok(payload.data.items[0].evidenceCount >= 2);
  });

  test('returns protected pattern detail with supporting evidence', async () => {
    const response = await fetch(`${baseUrl}/api/v2/patterns/${patternId}`, {
      headers: { Cookie: `token=${ownerToken}` }
    });
    const payload = await response.json();
    assert.equal(response.status, 200);
    assert.equal(payload.data.pattern.id, patternId);
    assert.ok(payload.data.evidence.length >= 2);
  });

  test('rejects discovery without idempotency header', async () => {
    const response = await fetch(`${baseUrl}/api/v2/brands/${brandId}/patterns/discover`, {
      method: 'POST',
      headers: { Cookie: `token=${ownerToken}`, 'Content-Type': 'application/json' },
      body: JSON.stringify({ force: false })
    });
    assert.equal(response.status, 400);
  });

  test('queues an idempotent DISCOVER_PATTERNS job for a qualified catalogue', async () => {
    const response = await fetch(`${baseUrl}/api/v2/brands/${brandId}/patterns/discover`, {
      method: 'POST',
      headers: {
        Cookie: `token=${ownerToken}`,
        'Content-Type': 'application/json',
        'Idempotency-Key': 'phase6-api-discovery-1'
      },
      body: JSON.stringify({ force: false })
    });
    const payload = await response.json();
    assert.equal(response.status, 202);
    assert.equal(payload.data.job.type, 'DISCOVER_PATTERNS');
    assert.match(payload.data.job.id, /^[0-9a-f-]{36}$/);
  });

  test('catalogue version changes when derived metrics are recalculated', async () => {
    const before = await getPatternCatalogueVersion(brandId);
    const latestMetric = await prisma.contentDerivedMetric.findFirst({
      where: { content: { brandId } },
      orderBy: { calculatedAt: 'desc' }
    });
    await prisma.contentDerivedMetric.update({
      where: { id: latestMetric.id },
      data: { calculatedAt: new Date('2030-01-01T00:00:00.000Z') }
    });
    const after = await getPatternCatalogueVersion(brandId);
    assert.notEqual(after, before);
  });

  test('denies cross-brand pattern access', async () => {
    const response = await fetch(`${baseUrl}/api/v2/brands/${otherBrandId}/patterns`, {
      headers: { Cookie: `token=${ownerToken}` }
    });
    assert.equal(response.status, 403);
  });
});

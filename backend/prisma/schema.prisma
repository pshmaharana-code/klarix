// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobType {
  SYNC_ACCOUNT
}

enum JobState {
  CREATED
  QUEUED
  PROCESSING
  RETRY_PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum JobLogLevel {
  INFO
  ERROR
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String   // Added for local auth
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brands    Brand[]
  memberships BrandMember[]
  oauthStates OAuthState[]

  @@map("users")
}

model Brand {
  id               String   @id @default(uuid())
  ownerUserId      String   @map("owner_user_id")
  name             String
  onboardingStatus String   @default("PENDING") @map("onboarding_status")
  positioning      String?
  audience         String?
  goals            String?
  voiceStyleInputs String?  @map("voice_style_inputs")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  owner            User          @relation(fields: [ownerUserId], references: [id])
  members          BrandMember[]
  socialAccounts   SocialAccount[]
  jobs             Job[]
  oauthStates      OAuthState[]

  @@map("brands")
}

model BrandMember {
  brandId   String   @map("brand_id")
  userId    String   @map("user_id")
  role      String   @default("MEMBER")
  createdAt DateTime @default(now()) @map("created_at")

  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([brandId, userId])
  @@map("brand_members")
}

model SocialAccount {
  id                String   @id @default(uuid())
  brandId           String   @map("brand_id")
  platform          String
  externalAccountId String   @map("external_account_id")
  username          String
  accountType       String?  @map("account_type")
  profileMetadata   Json?    @map("profile_metadata")
  connectionStatus  String   @default("CONNECTED") @map("connection_status")
  encryptedToken    String?  @map("encrypted_token")
  expiry            DateTime?
  lastSync          DateTime? @map("last_sync")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  brand             Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([platform, externalAccountId])
  @@map("social_accounts")
}

model Job {
  id               String   @id @default(uuid())
  brandId          String   @map("brand_id")
  type             JobType
  state            JobState @default(QUEUED)
  idempotencyKey   String   @map("idempotency_key")
  progressPercent  Int      @default(0) @map("progress_percent")
  progressStep     String?  @map("progress_step")
  progressMessage  String?  @map("progress_message")
  input            Json?
  result           Json?
  error            Json?
  attempts         Int      @default(0)
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  brand            Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  logs             JobLog[]
  outbox           JobOutbox?

  @@unique([brandId, idempotencyKey])
  @@map("jobs")
}

model JobLog {
  id        String   @id @default(uuid())
  jobId     String   @map("job_id")
  level     JobLogLevel @default(INFO)
  event     String
  context   Json?
  timestamp DateTime @default(now())

  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_logs")
  @@index([jobId, timestamp])
}

model JobOutbox {
  id          String   @id @default(uuid())
  jobId       String   @unique @map("job_id")
  deliveredAt DateTime? @map("delivered_at")
  claimedAt   DateTime? @map("claimed_at")
  attempts    Int      @default(0)
  lastError   String?  @map("last_error")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([deliveredAt, claimedAt])
  @@map("job_outbox")
}

model OAuthState {
  id        String   @id
  brandId   String   @map("brand_id")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([brandId, userId])
  @@map("oauth_states")
}

model OAuthCredential {
  id             String   @id @default(uuid())
  encryptedToken String   @map("encrypted_token")
  expiresAt      DateTime @map("expires_at")
  consumedAt     DateTime? @map("consumed_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("oauth_credentials")
}

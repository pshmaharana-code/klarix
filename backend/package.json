{
  "name": "klarix-backend",
  "version": "1.0.0",
  "description": "Klarix AI Social Media Performance Analyser 3-Agent Backend Engine",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "worker": "node worker.js",
    "db:deploy": "prisma migrate deploy",
    "test": "node --test test/v2-security.test.js",
    "test:security": "node --experimental-test-module-mocks --test test/v2-phase2-security.test.js test/v2-cancel.test.js",
    "test:gate2": "node --experimental-test-module-mocks --test test/v2-phase3-gate2.test.js",
    "test:gate3": "node --experimental-test-module-mocks --test-force-exit --test test/v2-phase3-gate3.test.js",
    "test:gate4": "node --experimental-test-module-mocks --test-force-exit --test test/v2-phase3-gate4.test.js",
    "test:phase5:unit": "node --test test/v2-phase5-analytics-pure.test.js",
    "test:phase5:analytics": "node --experimental-test-module-mocks --test-force-exit --test test/v2-phase5-analytics.test.js",
    "test:phase5:api": "node --experimental-test-module-mocks --test-force-exit --test test/v2-phase5-api.test.js",
    "test:phase5:worker": "node --experimental-test-module-mocks --test-force-exit --test test/v2-phase5-worker.test.js",
    "test:phase5": "npm run test:phase5:unit && npm run test:phase5:analytics && npm run test:phase5:api && npm run test:phase5:worker",
    "test:phase6:patterns": "node --test --test-force-exit test/v2-phase6-patterns.test.js",
    "test:phase6:api": "node --experimental-test-module-mocks --test-force-exit --test test/v2-phase6-api.test.js",
    "test:phase6:worker": "node --experimental-test-module-mocks --test-force-exit --test test/v2-phase6-worker.test.js",
    "test:phase6": "npm run test:phase6:patterns && npm run test:phase6:api && npm run test:phase6:worker",
    "test:all": "npm test && npm run test:security && npm run test:gate2 && npm run test:gate3 && npm run test:gate4 && npm run test:phase5 && npm run test:phase6",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "6.4.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "prisma": "6.4.1",
    "zod": "^4.6.5"
  },
  "author": "Piyush Maharana, IIT Madras",
  "license": "ISC"
}
